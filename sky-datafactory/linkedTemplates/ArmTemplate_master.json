{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "sky-datafactory"
		},
		"AzureDataLakeStorage_sky_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_sky_ADLS'"
		},
		"Snowflake_for_ADF_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Snowflake_for_ADF'"
		},
		"AzureDataLakeStorage_sky_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://skydatastorageacc.dfs.core.windows.net/"
		},
		"Snowflake_for_ADF_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ADF_LEARNING"
		},
		"Snowflake_for_ADF_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "sky-datafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_sky_ADLS_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_sky_ADLS_accountKey')]"
					},
					"Snowflake_for_ADF_password": {
						"value": "[parameters('Snowflake_for_ADF_password')]"
					},
					"AzureDataLakeStorage_sky_ADLS_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_sky_ADLS_properties_typeProperties_url')]"
					},
					"Snowflake_for_ADF_properties_typeProperties_database": {
						"value": "[parameters('Snowflake_for_ADF_properties_typeProperties_database')]"
					},
					"Snowflake_for_ADF_properties_typeProperties_role": {
						"value": "[parameters('Snowflake_for_ADF_properties_typeProperties_role')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}